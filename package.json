{
  "name": "dsh-models-sort",
  "version": "0.1.0",
  "description": "给 DSH 设置页的模型供应商列表加上 CC Switch 式拖拽排序与隐藏。按住卡片上的手柄上下拖动，其他卡片实时让位，松手顺序立即生效并写回 cordis.patch.yml；每张卡片可一键隐藏，隐藏的供应商集中到「已隐藏」分组，同时从聊天框的模型选择器里移除。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-sort",
    "drag-and-drop",
    "reorder",
    "cordis",
    "react"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.0-rc.2": "unknown",
        "0.2.0-rc.1": "unknown",
        "0.1.7-rc.2": "unknown"
      }
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Faust-zyb/dsh-models-sort.git"
  },
  "homepage": "https://github.com/Faust-zyb/dsh-models-sort#readme",
  "bugs": {
    "url": "https://github.com/Faust-zyb/dsh-models-sort/issues"
  },
  "license": "MIT"
}
